# IF [NOT] EXISTS turns the matching error into a no-op.

statement ok
CREATE TABLE IF NOT EXISTS users (id INT);

# Already there: a no-op, and the original Table is kept.
statement ok
CREATE TABLE IF NOT EXISTS users (name TEXT);

statement error table `users` already exists
CREATE TABLE users (id INT);

statement ok
DROP TABLE IF EXISTS users;

# Already gone: a no-op.
statement ok
DROP TABLE IF EXISTS users;

statement error no such table `users`
DROP TABLE users;

# IF NOT EXISTS only forgives the Table existing, not a bad Schema.
statement error Duplicate column name: `id`
CREATE TABLE IF NOT EXISTS t (id INT, id TEXT);

statement error line 1, col 17: expected NOT
CREATE TABLE IF EXISTS t (id INT);

statement error line 1, col 15: expected EXISTS
DROP TABLE IF NOT EXISTS t;
