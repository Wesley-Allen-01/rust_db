# SELECT ... FROM reads a Table's Rows in Row ID order.

statement ok
CREATE TABLE users (id INT NOT NULL, name TEXT, score FLOAT, active BOOL);

# An empty Table gives no Rows.
query ITRB
SELECT * FROM users;
----

statement ok
INSERT INTO users VALUES (1, 'ada', 9.5, true), (2, 'bob', NULL, false), (3, NULL, 7, NULL);

# `*` is every Column in Schema order.
query ITRB
SELECT * FROM users;
----
1 ada 9.5 true
2 bob NULL false
3 NULL 7 NULL

# Expressions read the current Row's Columns, with Coercion where INT meets FLOAT.
query IRT
SELECT id * 10, score + id, name || '!' FROM users;
----
10 10.5 ada!
20 NULL bob!
30 10 NULL

# Column and Table names are case-insensitive. Columns can repeat.
query II
SELECT ID, Id FROM USERS;
----
1 1
2 2
3 3

# AS names a Result Set Column. It works alongside FROM and WHERE.
query IT
SELECT id AS user_id, name || '?' AS asked FROM users WHERE id > 1;
----
2 bob?
3 NULL

# `*` can sit beside other items.
query IITRBT
SELECT id, *, name FROM users WHERE id = 1;
----
1 1 ada 9.5 true ada

# Rows come back in Row ID order, which is insertion order, not value order.
statement ok
CREATE TABLE nums (n INT);

statement ok
INSERT INTO nums VALUES (3), (1), (2);

query I
SELECT n FROM nums;
----
3
1
2
