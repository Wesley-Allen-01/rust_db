# DELETE removes the Rows for which WHERE is TRUE, or every Row without one.

statement ok
CREATE TABLE users (id INT, name TEXT);

statement ok
INSERT INTO users VALUES (1, 'ada'), (2, 'bob'), (3, NULL), (4, 'dee');

statement count 1
DELETE FROM users WHERE id = 2;

# NULL (unknown) drops a Row from the match, as in SELECT, so Row 3 stays.
statement count 1
DELETE FROM users WHERE name <> 'ada';

query IT
SELECT * FROM users;
----
1 ada
3 NULL

# A WHERE that matches nothing deletes nothing.
statement count 0
DELETE FROM users WHERE id > 100;

# Names are case-insensitive.
statement count 2
DELETE FROM USERS;

query IT
SELECT * FROM users;
----

statement count 1
INSERT INTO users VALUES (5, 'eve');

query IT
SELECT * FROM users;
----
5 eve

statement error no such table `nope`
DELETE FROM nope;

statement error no such column `email`
DELETE FROM users WHERE email = 'x';

statement error WHERE must be BOOL, got INT
DELETE FROM users WHERE id;

statement error line 1, col 8: expected FROM
DELETE users;
